<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/profile.css"
    </head>
  <body>
    <div class="containerpers">
    <div class="cardpers">
      <div class="profile-picture">
        <img src="https://images.unsplash.com/photo-1764352104218-2d3a899ce36c?q=80&w=715&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Profile Picture">
      </div>
      <h2 class="name"><%= user.fullname %></h2>
      <h3 class="username">@<%= user.username %></h3>
      <p class="tagline">I am the Best </p>
      <p class="description">I am trying hard to get job and earn money</p>
      
      <a href="/logout" class="button">Logout </a>
      <form action="/upload" method="post" enctype="multipart/form-data">
        <input type="text" name="filecaption" placeholder="some caption">
        <input type="file" name="file">
        <input type="submit">

      </form>
    
    </div>
    <div class="container">
        <div class="cards flex">
          <% user.posts.forEach(function(post){ %>
             <div class="card" style="width: 8rem;">
                <img src="/images/uploads/<%= post.image %>" class="card-img-top" alt="...">
                <div class="card-body">
                <h8  class="card-title "><%= post.imageText %></h8>
              </div>
            </div>  
          <% }) %>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>