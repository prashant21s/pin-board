<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel = "stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <div class="container">
      <div class="content">
        <!--pinterest logo-->
        <img src="/images/pinterest-logo.png.jpg" alt="pin logo" class="img1" />
        <p class="header">login account</p>
        <% if(error.length > 0){ %>
          <p class="error"><%= error %></p>
        <% } %>
        <form action="/login" method="post">
          <!-- <input type="email" name ="email" placeholder="Email" class="detail" /><br /> -->
          <input type="text" name="username" placeholder="username" class="detail" /><br />
          <!-- <input type="text" name="fullname" placeholder="fullname" class="detail" /><br /> -->
          
          <input type="password" name="password" placeholder="Password" class="detail" />
          <input type="submit" class="btn int" value="Login Account">
        </form>

        <a href="/forgot">Forgot your password?</a>

        
        

        <footer>
          <p>
            By continuing, you agree to Pinterest's
            <b>Terms of Service, Privacy policy.</b>
          </p>
          <hr />
          <a href="/">Not on Pinterest yet? Sign up</p>
        </footer>
      </div>
    </div>
    <!-- <a href="" class="upbtn">Sign up</a> -->

</body>
</html>